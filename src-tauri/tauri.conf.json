{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ybkauto",
  "version": "0.1.0",
  "identifier": "com.y.ybkauto",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YbkAuto",
        "width": 915,
        "height": 600,
        "minWidth": 915,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://你的更新服务器地址.com/check-update/{{target}}/{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExQ0ZEMkU3RDdCRDVDOEYKUldTUFhMM1g1OUxQRVRCWnptMUl2Q2NERnhoalVpRmxyUU84NzhXUW5EME11d2xZeWxrY3Z3Zm8K",
      "createUpdaterArtifacts": true
    }
  }
}
