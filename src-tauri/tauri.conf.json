{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "YbkAuto",
  "version": "0.1.0",
  "identifier": "com.y.ybkauto",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "YbkAuto",
        "width": 915,
        "height": 630,
        "minWidth": 915,
        "minHeight": 630,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": ["zh-CN"]
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExQ0ZEMkU3RDdCRDVDOEYKUldTUFhMM1g1OUxQRVRCWnptMUl2Q2NERnhoalVpRmxyUU84NzhXUW5EME11d2xZeWxrY3Z3Zm8K",
      "endpoints": [
        "https://github.com/9ycrooked/YbkAuto/releases/download/latest/updater.json"
      ],
      "createUpdaterArtifacts": true
    }
  }
}
